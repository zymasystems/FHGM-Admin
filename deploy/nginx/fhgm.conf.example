# Template for HOST Nginx. Install a valid certificate before enabling.
# This first release intentionally uses one origin per browsing session.
server {
    listen 80;
    server_name hisgraceministries.co.za admin.hisgraceministries.co.za;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name hisgraceministries.co.za admin.hisgraceministries.co.za;
    ssl_certificate /etc/letsencrypt/live/hisgraceministries.co.za/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hisgraceministries.co.za/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:5080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # The public host and admin host both proxy /api/ to the same app.
    # Do not point the browser at api.<domain> in this cookie-based release.
}
