# Template for HOST Nginx. Install a valid certificate before enabling.
# Administration vhost only. Keep the existing ministry website vhost.
server {
    listen 80;
    server_name admin.hisgraceministries.co.za;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name admin.hisgraceministries.co.za;
    ssl_certificate /etc/letsencrypt/live/admin.hisgraceministries.co.za/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.hisgraceministries.co.za/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:5080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
