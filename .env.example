# Copy to .env and replace every placeholder before starting.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
BOOTSTRAP_EMAIL=admin@example.org
BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_ADMIN_PASSWORD

# Use Production only with HTTPS through Nginx.
APP_ENVIRONMENT=Development
# Optional: exact socket peer IP of the host Nginx proxy, for forwarded headers.
NGINX_PROXY_ADDRESS=

# Reserved for the next R2 media implementation stage (never sent to MVC/browser).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
