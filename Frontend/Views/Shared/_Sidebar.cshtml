<aside class="sidebar" id="portal-navigation" aria-label="Portal navigation"><div class="sidebar-heading">
    <a class="brand ministry-brand" asp-controller="Dashboard" asp-action="Index"><img src="~/images/ministry-logo.png" alt="For His Grace Ministries"><span>For His Grace<br>Ministries</span></a><button id="portal-nav-close" class="icon-button sidebar-close" type="button" aria-label="Close navigation"><partial name="_Icon" model='"close"' /></button></div>
    <p class="eyebrow">ADMINISTRATION PORTAL</p>
    <nav aria-label="Administration"><span class="nav-section-label">WORKSPACE</span>
        <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "overview" ? "selected" : "")" asp-controller="Dashboard" asp-action="Index"><partial name="_Icon" model='"overview"' /><span>Overview</span></a>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("ChurchAdmin") || User.IsInRole("MediaManager"))
        { <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "gallery" ? "selected" : "")" asp-controller="Dashboard" asp-action="Gallery"><partial name="_Icon" model='"gallery"' /><span>Photo gallery</span></a> }
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("ChurchAdmin") || User.IsInRole("Writer") || User.IsInRole("BlogEditor"))
        { <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "blogs" ? "selected" : "")" asp-controller="Dashboard" asp-action="Blogs"><partial name="_Icon" model='"blogs"' /><span>Blog articles</span></a> }
        @if (User.IsInRole("SuperAdmin"))
        {
            <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "monitoring" ? "selected" : "")" asp-controller="Dashboard" asp-action="Monitoring"><partial name="_Icon" model='"monitoring"' /><span>Monitoring</span></a>
            <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "users" ? "selected" : "")" asp-controller="Dashboard" asp-action="Users"><partial name="_Icon" model='"users"' /><span>Team members</span></a>
            <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "audit" ? "selected" : "")" asp-controller="Dashboard" asp-action="Audit"><partial name="_Icon" model='"audit"' /><span>Activity log</span></a>
        }
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("ChurchAdmin") || User.IsInRole("CommunicationsManager"))
        {
            <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "events" ? "selected" : "")" asp-controller="Dashboard" asp-action="Events"><partial name="_Icon" model='"events"' /><span>Events</span></a>
            <a class="nav-item @(ViewData["ActiveView"]?.ToString() == "popups" ? "selected" : "")" asp-controller="Dashboard" asp-action="Popups"><partial name="_Icon" model='"popups"' /><span>Popup announcements</span></a>
        }
    </nav>
    <div class="sidebar-bottom"><span class="nav-section-label">ACCOUNT & RESOURCES</span>
        <a href="https://hisgraceministries.co.za/" target="_blank" rel="noopener">View ministry website ↗</a>
        <a href="/public/" target="_blank" rel="noopener">Preview CMS blog feed ↗</a>
        <a href="/public/events" target="_blank" rel="noopener">Preview events & popups ↗</a>
        <a class="nav-item @(Context.Request.Path.StartsWithSegments("/account/security") ? "selected" : "")" href="/account/security"><partial name="_Icon" model='"security"' /><span>Password & security</span></a>
        <p id="identity">@User.Identity?.Name</p>
        <button id="logout" class="btn btn-outline-secondary outline"><partial name="_Icon" model='"logout"' /><span>Sign out</span></button>
    </div>
</aside>
