<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Content administration for For His Grace Ministries.">
    <title>@ViewData["Title"] · FHGM Administration</title>
    <link rel="icon" type="image/png" href="~/images/ministry-logo.png">
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="~/shared/styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/shared/ministry.css" asp-append-version="true">
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js" defer></script>
</head>
<body data-view="@ViewData["ActiveView"]">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
