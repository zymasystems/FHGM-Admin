<section id="gallery-view">
    <div class="page-heading"><div><p class="eyebrow">YOUR CHURCH · YOUR STORIES</p><h1>Photo gallery</h1><p class="muted">Upload your ministry photos and choose what appears on the website.</p></div><a href="/public/gallery" class="btn btn-outline-secondary outline" target="_blank" rel="noopener">Preview gallery ↗</a></div>
    <p id="gallery-storage-message" role="status" class="review-note" hidden></p>
    <div class="gallery-workspace">
        <aside>
            <div class="panel p-4"><h2>Albums</h2><label class="mb-3">Choose an album<select id="album-select" class="form-select"><option value="">Create your first album</option></select></label><div class="d-flex gap-2 mb-3"><button id="albums-prev" class="btn outline" type="button">Previous</button><button id="albums-next" class="btn outline" type="button">Next</button></div><button id="album-new" class="btn outline" type="button">+ New album</button></div>
            <form id="album-form" class="panel p-4"><h2 id="album-form-title">New album</h2><label class="mb-3">Album title<input class="form-control" name="title" maxlength="160" placeholder="Sunday Service" required></label><label class="mb-3">Album URL name<input class="form-control" name="slug" maxlength="180" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="sunday-service" required></label><label class="mb-3">Description<textarea class="form-control" name="description" maxlength="1000" rows="3"></textarea></label><label class="check-label mb-3"><input type="checkbox" name="isPublished"> Publish album on the website</label><p class="small muted">The website shows photos only when the photo and its album are both published.</p><button class="btn btn-primary primary" type="submit">Save album</button></form>
        </aside>
        <div>
            <form id="gallery-upload-form" class="panel p-4"><p class="eyebrow">ADD YOUR PHOTOS</p><h2>Upload images</h2><label>Choose photos<input id="gallery-files" name="files" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" multiple required></label><p class="small muted mt-2">JPEG, PNG or WebP · Up to 10 MB each · Select up to 20 photos at a time.</p><button id="gallery-upload" class="btn btn-primary primary" type="submit" disabled>Upload to this album</button><progress id="gallery-progress" class="gallery-progress" max="100" value="0" hidden></progress><div id="gallery-upload-status" role="log" aria-live="polite" class="small mt-3"></div></form>
            <div class="panel p-4"><div class="d-flex justify-content-between gap-3 flex-wrap mb-4"><div><h2 id="gallery-images-title">Album photos</h2><p id="gallery-images-description" class="small muted mb-0">Save or select an album to add images.</p></div><button id="gallery-refresh" class="btn outline" type="button">Refresh</button></div><div id="gallery-images" class="gallery-image-grid"></div><p id="gallery-empty" class="muted">Your photos will appear here.</p><div class="pager px-0"><button id="images-prev" class="btn outline" type="button">Previous</button><span id="images-page"></span><button id="images-next" class="btn outline" type="button">Next</button></div></div>
        </div>
    </div>
</section>
