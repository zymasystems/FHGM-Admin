@model DashboardViewModel
@{ ViewData["Title"] = "Content studio"; ViewData["ActiveView"] = Model.ActiveView; }
<div id="workspace" class="workspace">
    <partial name="_Sidebar" />
    <main class="main">
        <header class="topbar"><span>FOR HIS GRACE MINISTRIES</span><span class="status-dot">Content studio</span></header>
        <div id="notice" role="status" aria-live="polite"></div>
        @switch (Model.ActiveView)
        {
            case "blogs": <partial name="_Blogs" /> break;
            case "gallery": <partial name="_Gallery" /> break;
            case "users": <partial name="_Users" /> break;
            case "audit": <partial name="_Audit" /> break;
            case "events": <partial name="_Events" /> break;
            case "popups": <partial name="_Popups" /> break;
            case "monitoring": <partial name="_Monitoring" /> break;
            default:
                <section class="dashboard-overview">
                    <div class="dashboard-welcome">
                        <div>
                            <p class="eyebrow">YOUR MINISTRY WORKSPACE</p>
                            <h1>Welcome back, @User.Identity?.Name</h1>
                            <p>Here’s what’s happening across For His Grace Ministries today.</p>
                        </div>
                        <span class="dashboard-live"><span></span> Workspace active</span>
                    </div>

                    <div class="dashboard-section-heading">
                        <div><p class="eyebrow">AT A GLANCE</p><h2>Content overview</h2></div>
                        <span class="dashboard-updated">Live workspace summary</span>
                    </div>
                    <div id="dashboard-summary" class="dashboard-summary" role="region" aria-label="Content needing attention" aria-live="polite">
                        <div class="dashboard-loading">Loading your content summary…</div>
                    </div>

                    <div class="dashboard-section-heading dashboard-actions-heading">
                        <div><p class="eyebrow">QUICK ACCESS</p><h2>Keep your ministry moving</h2></div>
                    </div>
                    <div class="dashboard-quick-grid">
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("ChurchAdmin") || User.IsInRole("MediaManager"))
                        {
                            <a class="dashboard-action-card" asp-action="Gallery">
                                <span class="dashboard-action-icon" aria-hidden="true">▧</span>
                                <span><strong>Photo gallery</strong><small>Organize albums and share ministry moments.</small></span>
                                <span class="dashboard-arrow" aria-hidden="true">↗</span>
                            </a>
                        }
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("ChurchAdmin") || User.IsInRole("Writer") || User.IsInRole("BlogEditor"))
                        {
                            <a class="dashboard-action-card" asp-action="Blogs">
                                <span class="dashboard-action-icon" aria-hidden="true">✎</span>
                                <span><strong>Blog articles</strong><small>Write, review and publish stories of faith.</small></span>
                                <span class="dashboard-arrow" aria-hidden="true">↗</span>
                            </a>
                        }
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("ChurchAdmin") || User.IsInRole("CommunicationsManager"))
                        {
                            <a class="dashboard-action-card" asp-action="Events">
                                <span class="dashboard-action-icon" aria-hidden="true">▦</span>
                                <span><strong>Events & announcements</strong><small>Keep your church family up to date.</small></span>
                                <span class="dashboard-arrow" aria-hidden="true">↗</span>
                            </a>
                        }
                        <a class="dashboard-action-card" href="/account/security">
                            <span class="dashboard-action-icon" aria-hidden="true">◇</span>
                            <span><strong>Account security</strong><small>Review your password and sign-in protection.</small></span>
                            <span class="dashboard-arrow" aria-hidden="true">↗</span>
                        </a>
                    </div>

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("ChurchAdmin") || User.IsInRole("CommunicationsManager"))
                    {
                        <div class="dashboard-ministry-note">
                            <div><p class="eyebrow">FOR HIS GRACE MINISTRIES</p><h2>Growing in grace. Living by faith.</h2><p>Share what God is doing in your church family with the people who need to hear it.</p></div>
                            <a href="https://hisgraceministries.co.za/" target="_blank" rel="noopener">Visit ministry website <span aria-hidden="true">↗</span></a>
                        </div>
                    }
                </section>
                break;
        }
    </main>
</div>
@if (Model.ActiveView == "blogs") { <partial name="_Editor" /> }
@section Scripts {
    <script src="~/shared/content-renderer.js" asp-append-version="true" defer></script>
    <script src="~/admin/app.js" asp-append-version="true" defer></script>
    @if (Model.ActiveView == "overview") { <script src="~/admin/dashboard.js" asp-append-version="true" defer></script> }
    @if (Model.ActiveView == "gallery") { <script src="~/admin/gallery.js" asp-append-version="true" defer></script> }
    @if (Model.ActiveView == "events" || Model.ActiveView == "popups") { <script src="~/admin/church-content.js" asp-append-version="true" defer></script> }
    @if (Model.ActiveView == "monitoring") { <script src="~/admin/monitoring.js" asp-append-version="true" defer></script> }
}
