<dialog id="editor"><form id="blog-form"><div class="dialog-heading"><div><p class="eyebrow">ARTICLE EDITOR</p><h2 id="editor-heading">New article</h2></div><button type="button" id="close-editor" class="btn btn-outline-secondary outline">Close</button></div><p id="editor-status" class="muted"></p><p id="review-note" class="review-note" hidden></p><div class="form-grid"><label class="full">Title<input class="form-control" name="title" maxlength="180" required></label><label class="full">URL slug<input class="form-control" name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="200" placeholder="a-story-of-grace" required></label><label class="full">Excerpt<textarea class="form-control" name="excerpt" maxlength="500" rows="2" required></textarea></label><label class="full">Article content<textarea class="form-control" name="content" maxlength="50000" rows="12" required></textarea><span class="muted small">Plain text. Separate paragraphs with a blank line.</span></label><label>Category<input class="form-control" name="category" maxlength="100"></label><label>Tags, separated by commas<input class="form-control" name="tags" maxlength="500"></label><label>SEO title<input class="form-control" name="seoTitle" maxlength="180"></label><label>SEO description<input class="form-control" name="seoDescription" maxlength="320"></label></div><p id="editor-error" class="error" role="alert"></p><div class="editor-footer"><button id="save-blog" type="submit" class="btn btn-primary primary">Save draft</button><span class="muted small">Save changes before using a workflow action below.</span></div></form><div id="workflow" class="workflow"></div></dialog>
